DerridaRetaux.FixedArity.cubicWeightedInfiniteChain (m : ℕ) (data : DerridaRetaux.ProfileInitialData m) :
  ∃ μ,
    MeasureTheory.IsProbabilityMeasure μ ∧
      (∀ (n : ℕ), MeasureTheory.Measure.map (fun w i => w ↑i) μ = (DerridaRetaux.spinePathPMF m data n).toMeasure) ∧
        (∀ (n : ℕ), MeasureTheory.Measure.map (fun w => w n) μ = (DerridaRetaux.spineMarginalPMF m data n).toMeasure) ∧
          ∀ (n : ℕ),
            MeasureTheory.Measure.map (fun w => (fun i => w ↑i, w (n + 1))) μ =
              ((DerridaRetaux.spinePathPMF m data n).bind fun u =>
                  PMF.map (fun k => (u, k))
                    (DerridaRetaux.spineKernel m data n (DerridaRetaux.finPathTerminal u))).toMeasure
